# Copy to ".env". The UI can also override base URL / key / model at runtime.
OLLAMA_BASE_URL=https://ollama.com     # local: http://localhost:11434
OLLAMA_API_KEY=                        # required for Ollama Cloud
OLLAMA_MODEL=gpt-oss:120b
PORT=5090
MAX_CONCURRENT=2                       # tests run at most this many at once (rate-limit safety)
