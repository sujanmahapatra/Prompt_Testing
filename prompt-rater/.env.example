# Copy this file to ".env" and adjust as needed. All values are optional.
# The UI Settings panel can override every one of these at runtime.

# Where your Ollama server lives.
#   Local Ollama (default, no key needed):   http://localhost:11434
#   Ollama Cloud (needs an API key below):   https://ollama.com
OLLAMA_BASE_URL=http://localhost:11434

# Only needed for Ollama Cloud or a secured/remote Ollama. Leave blank for local.
OLLAMA_API_KEY=

# The default model used to rate prompts. Must be pulled locally (`ollama pull <model>`)
# or available on your Ollama Cloud account. Good picks: gpt-oss:20b, qwen2.5:14b, llama3.1:8b
OLLAMA_MODEL=llama3.1:8b

# Port the local web app runs on.
PORT=5080
